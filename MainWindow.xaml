<!-- 
    Projet: Générateur de Dictionnaire de Mots de Passe
    Auteurs: Oumar Diogo Bah et Eli Daniel Senyo
    Description: Interface graphique pour générer des dictionnaires de mots de passe
                 avec des paramètres personnalisables
-->

<Window x:Class="PasswordDictionaryGenerator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Générateur de Dictionnaire de Mots de Passe" 
        Height="700" Width="900"
        Background="#F0F0F0">
    <!-- Grid principal avec 7 rangées -->
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Longueur des mots de passe -->
            <RowDefinition Height="Auto"/>
            <!-- Caractères permis -->
            <RowDefinition Height="Auto"/>
            <!-- Caractères spéciaux -->
            <RowDefinition Height="Auto"/>
            <!-- Fichier de sortie -->
            <RowDefinition Height="Auto"/>
            <!-- Informations de progression -->
            <RowDefinition Height="Auto"/>
            <!-- Bouton Générer -->
            <RowDefinition Height="*"/>
            <!-- Zone de log -->
        </Grid.RowDefinitions>

        <!-- Section 1: Configuration de la longueur des mots de passe -->
        <GroupBox Grid.Row="0" Header="Longueur des mots de passe" 
                 Margin="0,0,0,10" 
                 Background="White"
                 BorderBrush="#CCCCCC">
            <StackPanel Orientation="Horizontal" Margin="10">
                <!-- Champs pour définir la longueur minimale et maximale -->
                <Label Content="Minimum:" Width="70"/>
                <TextBox x:Name="MinLengthTextBox" Width="50" Margin="0,0,20,0" 
                         VerticalContentAlignment="Center"/>
                <Label Content="Maximum:" Width="70"/>
                <TextBox x:Name="MaxLengthTextBox" Width="50" 
                         VerticalContentAlignment="Center"/>
            </StackPanel>
        </GroupBox>

        <!-- Section 2: Configuration des caractères permis -->
        <GroupBox Grid.Row="1" Header="Caractères permis" 
                 Margin="0,0,0,10" 
                 Background="White"
                 BorderBrush="#CCCCCC">
            <Grid Margin="10">
                <!-- Trois colonnes pour les différents types de caractères -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Section Minuscules -->
                <GroupBox Grid.Column="0" Header="Lettres minuscules" Margin="5">
                    <StackPanel>
                        <CheckBox x:Name="LowercaseCheckBox" 
                                Content="Activer (a-z)" 
                                Margin="5"/>
                        <!-- Zone de texte pour caractères minuscules personnalisés -->
                        <TextBox x:Name="CustomLowercaseTextBox" 
                                Height="50" 
                                Margin="5"
                                TextWrapping="Wrap"
                                AcceptsReturn="True"
                                ToolTip="Entrez vos lettres minuscules personnalisées"
                                GotFocus="TextBox_GotFocus"
                                LostFocus="TextBox_LostFocus"
                                Text="Exemple: abcd (lettres minuscules supplémentaires)"
                                Foreground="Gray"/>
                    </StackPanel>
                </GroupBox>

                <!-- Section Majuscules -->
                <GroupBox Grid.Column="1" Header="Lettres majuscules" Margin="5">
                    <StackPanel>
                        <CheckBox x:Name="UppercaseCheckBox" 
                                Content="Activer (A-Z)" 
                                Margin="5"/>
                        <!-- Zone de texte pour caractères majuscules personnalisés -->
                        <TextBox x:Name="CustomUppercaseTextBox" 
                                Height="50" 
                                Margin="5"
                                TextWrapping="Wrap"
                                AcceptsReturn="True"
                                ToolTip="Entrez vos lettres majuscules personnalisées"
                                GotFocus="TextBox_GotFocus"
                                LostFocus="TextBox_LostFocus"
                                Text="Exemple: ABCD (lettres majuscules supplémentaires)"
                                Foreground="Gray"/>
                    </StackPanel>
                </GroupBox>

                <!-- Section Chiffres -->
                <GroupBox Grid.Column="2" Header="Chiffres" Margin="5">
                    <StackPanel>
                        <CheckBox x:Name="NumbersCheckBox" 
                                Content="Activer (0-9)" 
                                Margin="5"/>
                        <!-- Zone de texte pour chiffres personnalisés -->
                        <TextBox x:Name="CustomNumbersTextBox" 
                                Height="50" 
                                Margin="5"
                                TextWrapping="Wrap"
                                AcceptsReturn="True"
                                ToolTip="Entrez vos chiffres personnalisés"
                                GotFocus="TextBox_GotFocus"
                                LostFocus="TextBox_LostFocus"
                                Text="Exemple: 123 (chiffres supplémentaires)"
                                Foreground="Gray"/>
                    </StackPanel>
                </GroupBox>
            </Grid>
        </GroupBox>

        <!-- Section 3: Configuration des caractères spéciaux -->
        <GroupBox Grid.Row="2" Header="Caractères spéciaux" 
                 Margin="0,0,0,10"
                 Background="White"
                 BorderBrush="#CCCCCC">
            <StackPanel Margin="10">
                <!-- Cases à cocher pour les caractères spéciaux prédéfinis -->
                <WrapPanel Margin="0,5">
                    <CheckBox x:Name="SpecialHash" Content="#" Margin="5"/>
                    <CheckBox x:Name="SpecialDollar" Content="$" Margin="5"/>
                    <CheckBox x:Name="SpecialPercent" Content="%" Margin="5"/>
                    <CheckBox x:Name="SpecialAnd" Content="&amp;" Margin="5"/>
                    <CheckBox x:Name="SpecialStar" Content="*" Margin="5"/>
                    <CheckBox x:Name="SpecialQuestion" Content="?" Margin="5"/>
                </WrapPanel>
                <!-- Zone de texte pour caractères spéciaux personnalisés -->
                <TextBox x:Name="CustomCharsTextBox" 
                        Height="50" 
                        Margin="5"
                        TextWrapping="Wrap"
                        AcceptsReturn="True"
                        ToolTip="Entrez des caractères spéciaux supplémentaires"
                        GotFocus="TextBox_GotFocus"
                        LostFocus="TextBox_LostFocus"
                        Text="Exemple: @!+ (caractères spéciaux supplémentaires)"
                        Foreground="Gray"/>
            </StackPanel>
        </GroupBox>

        <!-- Section 4: Sélection du fichier de sortie -->
        <GroupBox Grid.Row="3" Header="Fichier de sortie" 
                 Margin="0,0,0,10"
                 Background="White"
                 BorderBrush="#CCCCCC">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- Champ de texte pour le chemin du fichier -->
                <TextBox x:Name="OutputFileTextBox" Margin="0,0,10,0"/>
                <!-- Bouton pour parcourir les fichiers -->
                <Button x:Name="BrowseButton" 
                        Content="Parcourir..." 
                        Width="100" 
                        Grid.Column="1"
                        Click="BrowseButton_Click"
                        Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"/>
            </Grid>
        </GroupBox>

        <!-- Section 5: Affichage de la progression -->
        <GroupBox Grid.Row="4" Header="Progression" 
                 Margin="0,0,0,10"
                 Background="White"
                 BorderBrush="#CCCCCC">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Compteur de mots de passe générés -->
                <TextBlock Grid.Row="0" Grid.Column="0" 
                          Text="Mots de passe générés : " 
                          Margin="0,0,10,5"/>
                <TextBlock x:Name="PasswordCountTextBlock" 
                          Grid.Row="0" Grid.Column="1" 
                          Text="0" 
                          Margin="0,0,0,5"/>

                <!-- Temps restant estimé -->
                <TextBlock Grid.Row="1" Grid.Column="0" 
                          Text="Temps restant estimé : " 
                          Margin="0,0,10,5"/>
                <TextBlock x:Name="TimeRemainingTextBlock" 
                          Grid.Row="1" Grid.Column="1" 
                          Text="--:--:--" 
                          Margin="0,0,0,5"/>

                <!-- Barre de progression -->
                <ProgressBar x:Name="GenerationProgress" 
                           Grid.Row="2" Grid.ColumnSpan="2"
                           Height="20"/>
            </Grid>
        </GroupBox>

        <!-- Section 6: Bouton de génération -->
        <Button x:Name="GenerateButton" 
                Grid.Row="5"
                Content="Générer le dictionnaire" 
                Height="30" 
                Margin="0,10"
                Background="#007ACC"
                Foreground="White"
                Click="GenerateButton_Click"/>

        <!-- Section 7: Zone de log pour les messages -->
        <TextBox x:Name="LogTextBox" 
                 Grid.Row="6"
                 IsReadOnly="True" 
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 Background="White"
                 BorderBrush="#CCCCCC"
                 Margin="0,10,0,0"/>
    </Grid>
</Window>